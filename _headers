/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' *.googletagmanager.com *.jsdelivr.net; style-src 'self' 'unsafe-inline' *.cloudflare.com *.jsdelivr.net; font-src 'self' *.cloudflare.com; connect-src 'self' *.github.com *.jsdelivr.net *.google-analytics.com *.analytics.google.com; img-src 'self' *.jsdelivr.net *.google-analytics.com *.analytics.google.com;
